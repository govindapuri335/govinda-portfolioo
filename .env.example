# =============================================================================
# .env.example  --  TEMPLATE ONLY. Copy to .env and fill in real values there.
# NEVER put real secrets in this file. This file is committed to git.
# =============================================================================

# =========================
# Postgres (Drizzle ORM)
# =========================
# Pooled connection string (Neon/Supabase/Vercel Postgres/Railway/local).
# For Neon/Supabase use the POOLED URL (pgbouncer, port 6543) for the app.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Optional: direct (non-pooled) URL used only by drizzle-kit migrations.
DATABASE_URL_MIGRATIONS=

# =========================
# Admin auth
# =========================
# The single admin password used to log in to /admin.
ADMIN_PASSWORD=change-me-to-something-strong
# 32+ char random string used to sign the session cookie.
# Generate one with: openssl rand -base64 48
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Cookie name (optional, defaults to `portfolio_admin`).
ADMIN_SESSION_COOKIE_NAME=portfolio_admin

# =========================
# Cloudinary (images)
# =========================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Exposed to the browser for direct uploads / next/image loader.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Folder used for signed uploads.
CLOUDINARY_UPLOAD_FOLDER=portfolio/blogs

# =========================
# Analytics / SEO
# =========================
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_MEASUREMENT_ID=

# =========================
# Upstash Redis (visits counter + admin login rate-limiting)
# =========================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
VISITS_USE_UPSTASH=1

COUNTERAPI_BASE=
COUNTERAPI_KEY=
VISITS_DISPLAY_CACHE_TTL=60
VISITS_DEDUPE_TTL_SECONDS=21600

# =========================
# Contact form email notifications (Resend)
# =========================
# Sign up at https://resend.com, create an API key, and verify a sender domain.
# During development you can leave RESEND_FROM as "onboarding@resend.dev".
RESEND_API_KEY=
RESEND_FROM=Portfolio <onboarding@resend.dev>
# Where new contact-form messages are delivered.
CONTACT_TO_EMAIL=
